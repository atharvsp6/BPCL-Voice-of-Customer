# =============================================================================
# BPCL Voice of Customer (VoC) — Environment Configuration Template
# =============================================================================

# ── Supabase PostgreSQL Database (IPv4 Transaction Pooler Recommended) ─────────
# Format: postgresql://[user].[ref]:[password]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.cneeldkoedeoaijfgjiw:YOUR_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── Groq LLM API Key (For Aspect Categorization & Root Cause Extraction) ───────
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Scraping & External APIs (Optional) ────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_data_api_v3_key
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=bpcl-voc-scraper
TWITTER_USERNAME=
TWITTER_PASSWORD=
IG_USERNAME=
IG_PASSWORD=
