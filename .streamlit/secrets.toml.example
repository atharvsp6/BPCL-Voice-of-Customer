# ============================================================
# Streamlit Cloud Secrets Template
# ============================================================
# How to use:
#   Streamlit Cloud → Your App → Settings → Secrets
#   Paste the contents below (filled with real values)
#
# For local dev:  save as  .streamlit/secrets.toml
# ============================================================

# ── PostgreSQL connection (Supabase) ─────────────────────────
[connections.postgresql]
dialect      = "postgresql"
host         = "db.YOUR_SUPABASE_REF.supabase.co"
port         = 5432
database     = "postgres"
username     = "postgres"
password     = "YOUR_SUPABASE_DB_PASSWORD"

# ── Optional: expose DB URL as a plain string too ────────────
# (used by pipeline/run_daily.py when run from Streamlit)
SUPABASE_DB_URL = "postgresql://postgres:YOUR_SUPABASE_DB_PASSWORD@db.YOUR_SUPABASE_REF.supabase.co:5432/postgres"
